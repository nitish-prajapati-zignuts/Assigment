{
  "openapi": "3.0.0",
  "info": {
    "title": "Syncra AI Meeting Notes API Documentation",
    "version": "1.0.0",
    "description": "API endpoints for authentication, meeting note processing, task extraction, and action tracking."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Alice Developer"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "securepass123"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "securepass123"
          }
        }
      },
      "MeetingInput": {
        "type": "object",
        "required": ["title", "transcript"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Syncra Weekly Sync"
          },
          "transcript": {
            "type": "string",
            "example": "Priya: Let's focus on the tablet layout. Nitish: Sure, I'll update it. Alice: I will verify it."
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-08-14"
          },
          "description": {
            "type": "string",
            "example": "General review of ongoing features and sprint board alignment"
          }
        }
      },
      "ActionItemInput": {
        "type": "object",
        "required": ["task", "owner", "dueDate", "priority", "status"],
        "properties": {
          "task": {
            "type": "string",
            "example": "Fix column header widths in ActionItemsTable"
          },
          "owner": {
            "type": "string",
            "example": "Nitish Prajapati"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-16"
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"],
            "example": "High"
          },
          "status": {
            "type": "string",
            "enum": ["Pending", "In Progress", "Completed", "Blocked"],
            "example": "In Progress"
          },
          "meetingId": {
            "type": "integer",
            "example": 1
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user account",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user credentials",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Retrieve currently authenticated user metadata",
        "tags": ["Authentication"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/meetings": {
      "get": {
        "summary": "List all meeting notes catalogs",
        "tags": ["Meetings"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of meetings retrieved successfully"
          }
        }
      },
      "post": {
        "summary": "Upload a new meeting transcript and auto-extract items",
        "tags": ["Meetings"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeetingInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Meeting uploaded successfully"
          }
        }
      }
    },
    "/api/meetings/{id}": {
      "get": {
        "summary": "Get specific meeting details",
        "tags": ["Meetings"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "put": {
        "summary": "Update specific meeting summary/transcript",
        "tags": ["Meetings"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeetingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "delete": {
        "summary": "Delete specific meeting note",
        "tags": ["Meetings"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/action-items": {
      "get": {
        "summary": "List all action tracker tasks",
        "tags": ["Action Items"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List retrieved successfully"
          }
        }
      },
      "post": {
        "summary": "Create new custom action item task manually",
        "tags": ["Action Items"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionItemInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Action item created successfully"
          }
        }
      }
    },
    "/api/action-items/{id}": {
      "put": {
        "summary": "Update specific action item details",
        "tags": ["Action Items"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionItemInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "delete": {
        "summary": "Delete specific action tracker item",
        "tags": ["Action Items"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  }
}
