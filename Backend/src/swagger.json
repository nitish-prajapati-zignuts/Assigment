        "description": "Dispatches requests to internal services using serviceId.",
        "tags": [
          "Centralized Service Router"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
