                  },
                  {
                    "$ref": "#/components/schemas/MeetingsUnarchiveRequest"
                  },
                  {
                    "$ref": "#/components/schemas/MeetingsRestoreRequest"
                  },
                  {
                    "$ref": "#/components/schemas/MeetingsPinRequest"
                  },
                  {
                    "$ref": "#/components/schemas/MeetingsCloneRequest"
                  },
                  {
                    "$ref": "#/components/schemas/MeetingsPermanentDeleteRequest"
                  },
                  {
                    "$ref": "#/components/schemas/MeetingsPublicShareGetRequest"
                  },
                  {
                    "$ref": "#/components/schemas/ActionItemsListRequest"
                  },
