# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=4000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# PostgreSQL connection string (use Neon for serverless)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ========================================
# JWT AUTHENTICATION
# ========================================
# Generate a secure JWT secret with: openssl rand -base64 32
# MUST be at least 32 characters for production
JWT_SECRET="your_secure_jwt_secret_key_min_32_characters_long"
JWT_EXPIRES_IN="7d"

# ========================================
# AI SERVICE PROVIDERS
# ========================================
# Google Gemini API (primary)
# Get from: https://ai.google.dev/
GOOGLE_GENERATIVE_AI_API_KEY="your_google_generative_ai_api_key"
GEMINI_FALL_BACK_KEY = "your_google_generative_ai_fall_back_api_key"

# CORS CONFIGURATION
# ========================================
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ========================================
# LOGGING & MONITORING
# ========================================
LOG_LEVEL="debug"  # debug, info, warn, error

# ========================================
# REQUEST HANDLING
# ========================================
# Maximum request body size (e.g., for file uploads)
MAX_REQUEST_SIZE="10mb"
# Request timeout in milliseconds
REQUEST_TIMEOUT="30000"

# ========================================
# RATE LIMITING
# ========================================
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS="900000"
# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS="100"
# Toggle rate limiter (set to false to bypass rate limiting completely)
ENABLE_RATE_LIMITER="true"
#AUTH RATE LIMITING CONFIGURATION
AUTH_RATE_LIMITER = 100
#AI RATE LIMITING CONFIGURATION
AI_RATE_LIMITER = 100
#API RATE LIMITER CONFIGURATION
API_RATE_LIMITER = 1000

